{
  "name": "@hydra/harness-api-remotes",
  "description": "Remote BFF assembly and Host Agent/Session lookup policy",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosch/bosch-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "bh": {
    "client": {
      "inject": [
        "@hydra/harness-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@hydra/harness-typert-protocol": "workspace:^"
  },
  "peerDependencies": {
    "@hydra/harness-agent": "workspace:^",
    "@hydra/harness-agent-presets": "workspace:^",
    "@hydra/harness-api-gateway": "workspace:^",
    "@hydra/harness-commands": "workspace:^",
    "@hydra/harness-cordis-host-runner": "workspace:^",
    "@hydra/harness-credentials": "workspace:^",
    "@hydra/harness-file-reference": "workspace:^",
    "@hydra/harness-goal": "workspace:^",
    "@hydra/harness-hooks-registry": "workspace:^",
    "@hydra/harness-host-plugin-inventory": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-mcp-registry": "workspace:^",
    "@hydra/harness-message-feedback": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/harness-session-persistence": "workspace:^",
    "@hydra/harness-session-reference": "workspace:^",
    "@hydra/harness-settings": "workspace:^",
    "@hydra/harness-skill": "workspace:^",
    "@hydra/harness-typert-registry": "workspace:^",
    "@hydra/cordis": "workspace:^"
  },
  "devDependencies": {
    "@hydra/harness-agent": "workspace:^",
    "@hydra/harness-agent-presets": "workspace:^",
    "@hydra/harness-api-gateway": "workspace:^",
    "@hydra/harness-commands": "workspace:^",
    "@hydra/harness-cordis-host-runner": "workspace:^",
    "@hydra/harness-credentials": "workspace:^",
    "@hydra/harness-file-reference": "workspace:^",
    "@hydra/harness-goal": "workspace:^",
    "@hydra/harness-hooks-registry": "workspace:^",
    "@hydra/harness-host-plugin-inventory": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-mcp-registry": "workspace:^",
    "@hydra/harness-message-feedback": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/harness-session-persistence": "workspace:^",
    "@hydra/harness-session-reference": "workspace:^",
    "@hydra/harness-settings": "workspace:^",
    "@hydra/harness-skill": "workspace:^",
    "@hydra/harness-typert-registry": "workspace:^",
    "@hydra/cordis": "workspace:^"
  }
}
