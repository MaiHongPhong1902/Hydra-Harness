{
  "name": "@hydra/harness-tool-browser",
  "description": "Model-facing browser_* tools (navigate, read, find, fill, click, type, upload, select, scroll, press, back, forward) over the Hydra harness embedded-browser seam (ctx.browsers)",
  "hydra": {
    "plugin": {
      "application": "Let the agent navigate websites, inspect page content, and interact with page controls."
    }
  },
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/browser/tool-browser"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra/harness-agent": "workspace:^",
    "@hydra/harness-attachment": "workspace:^",
    "@hydra/harness-browser-electron": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-system-prompt": "workspace:^",
    "@hydra/harness-tools": "workspace:^",
    "@hydra/cordis": "workspace:^",
    "@hydra/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydra/harness-agent": "workspace:^",
    "@hydra/harness-attachment": "workspace:^",
    "@hydra/harness-browser-electron": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/harness-system-prompt": "workspace:^",
    "@hydra/harness-tools": "workspace:^",
    "@hydra/cordis": "workspace:^",
    "@hydra/schemastery": "workspace:^"
  }
}
