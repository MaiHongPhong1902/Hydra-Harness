{
  "name": "@hydra1902/harness-client-ui-commands",
  "description": "Client command surface: global directory cache, '/' source, three command UI kinds, popupSelect registry",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/client/ui-commands"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "hydra": {
    "plugin": {
      "application": "Find and invoke available slash commands from conversation input."
    },
    "client": {
      "inject": [
        "@hydra1902/harness-api-remotes",
        "@hydra1902/harness-client-runtime",
        "@hydra1902/harness-client-locale",
        "@hydra1902/harness-client-ui-input-trigger",
        "@hydra1902/harness-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@hydra1902/harness-api-remotes": "workspace:^",
    "@hydra1902/harness-client-locale": "workspace:^",
    "@hydra1902/harness-client-runtime": "workspace:^",
    "@hydra1902/harness-client-ui-conversation": "workspace:^",
    "@hydra1902/harness-client-ui-input-trigger": "workspace:^",
    "@hydra1902/harness-commands": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  },
  "devDependencies": {
    "@hydra1902/harness-api-remotes": "workspace:^",
    "@hydra1902/harness-client-connection": "workspace:^",
    "@hydra1902/harness-client-locale": "workspace:^",
    "@hydra1902/harness-client-runtime": "workspace:^",
    "@hydra1902/harness-client-test-runtime": "workspace:^",
    "@hydra1902/harness-client-ui-conversation": "workspace:^",
    "@hydra1902/harness-client-ui-primitives": "workspace:^",
    "@hydra1902/harness-client-ui-input-trigger": "workspace:^",
    "@hydra1902/harness-client-ui-slots": "workspace:^",
    "@hydra1902/harness-commands": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "@hydra1902/cordis": "workspace:^",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
