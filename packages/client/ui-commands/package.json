{
  "name": "@bosch/bh-client-ui-commands",
  "description": "Client command surface: global directory cache, '/' source, three command UI kinds, popupSelect registry",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosch/bosch-harness.git",
    "directory": "packages/client/ui-commands"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "bh": {
    "client": {
      "inject": [
        "@bosch/bh-api-remotes",
        "@bosch/bh-client-runtime",
        "@bosch/bh-client-locale",
        "@bosch/bh-client-ui-input-trigger",
        "@bosch/bh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@bosch/bh-api-remotes": "workspace:^",
    "@bosch/bh-client-locale": "workspace:^",
    "@bosch/bh-client-runtime": "workspace:^",
    "@bosch/bh-client-ui-conversation": "workspace:^",
    "@bosch/bh-client-ui-input-trigger": "workspace:^",
    "@bosch/bh-commands": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@bosch/cordis": "workspace:^"
  },
  "devDependencies": {
    "@bosch/bh-api-remotes": "workspace:^",
    "@bosch/bh-client-connection": "workspace:^",
    "@bosch/bh-client-locale": "workspace:^",
    "@bosch/bh-client-runtime": "workspace:^",
    "@bosch/bh-client-test-runtime": "workspace:^",
    "@bosch/bh-client-ui-conversation": "workspace:^",
    "@bosch/bh-client-ui-primitives": "workspace:^",
    "@bosch/bh-client-ui-input-trigger": "workspace:^",
    "@bosch/bh-client-ui-slots": "workspace:^",
    "@bosch/bh-commands": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "@bosch/cordis": "workspace:^",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
