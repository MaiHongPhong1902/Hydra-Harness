{
  "name": "@hydra1902/harness-client-ui-conversation",
  "description": "Conversation domain: skeleton, ordered chat flow, composer with the Host-backed busy-Enter preference, and details host",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/client/ui-conversation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "hydra": {
    "plugin": {
      "application": "Read messages, compose prompts, and inspect conversation details."
    },
    "client": {
      "inject": [
        "@hydra1902/harness-client-connection",
        "@hydra1902/harness-client-locale",
        "@hydra1902/harness-client-runtime",
        "@hydra1902/harness-client-ui-settings",
        "@hydra1902/harness-api-remotes",
        "@hydra1902/harness-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.0.0",
    "@hydra1902/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@hydra1902/cordis": "workspace:^",
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-api-remotes": "workspace:^",
    "@hydra1902/harness-attachment": "workspace:^",
    "@hydra1902/harness-brand": "workspace:^",
    "@hydra1902/harness-client-connection": "workspace:^",
    "@hydra1902/harness-client-locale": "workspace:^",
    "@hydra1902/harness-client-runtime": "workspace:^",
    "@hydra1902/harness-client-ui-settings": "workspace:^",
    "@hydra1902/harness-client-ui-input-trigger": "workspace:^",
    "@hydra1902/harness-commands": "workspace:^",
    "@hydra1902/harness-compaction": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm-retry": "workspace:^",
    "@hydra1902/harness-session-stats": "workspace:^",
    "@hydra1902/harness-token-meter": "workspace:^",
    "@hydra1902/harness-tools": "workspace:^",
    "@hydra1902/harness-settings": "workspace:^",
    "@hydra1902/harness-client-ui-layout": "workspace:^",
    "@hydra1902/harness-goal": "workspace:^",
    "@hydra1902/harness-permission-presets": "workspace:^",
    "@hydra1902/harness-plan-mode": "workspace:^",
    "@hydra1902/harness-tool-todo": "workspace:^"
  },
  "devDependencies": {
    "@hydra1902/cordis": "workspace:^",
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-api-remotes": "workspace:^",
    "@hydra1902/harness-attachment": "workspace:^",
    "@hydra1902/harness-brand": "workspace:^",
    "@hydra1902/harness-client-connection": "workspace:^",
    "@hydra1902/harness-client-locale": "workspace:^",
    "@hydra1902/harness-client-runtime": "workspace:^",
    "@hydra1902/harness-client-test-runtime": "workspace:^",
    "@hydra1902/harness-client-ui-layout": "workspace:^",
    "@hydra1902/harness-client-ui-primitives": "workspace:^",
    "@hydra1902/harness-client-ui-settings": "workspace:^",
    "@hydra1902/harness-client-ui-input-trigger": "workspace:^",
    "@hydra1902/harness-client-ui-slots": "workspace:^",
    "@hydra1902/harness-commands": "workspace:^",
    "@hydra1902/harness-compaction": "workspace:^",
    "@hydra1902/harness-goal": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm-retry": "workspace:^",
    "@hydra1902/harness-permission-presets": "workspace:^",
