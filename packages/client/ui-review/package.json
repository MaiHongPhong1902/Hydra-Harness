{
  "name": "@hydra1902/harness-client-ui-review",
  "description": "Agent-owned change history, recorded diffs, Keep and Undo",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/client/ui-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "hydra": {
    "plugin": {
      "application": "Inspect agent-made file changes and choose which changes to keep or undo."
    },
    "client": {
      "inject": [
        "@hydra1902/harness-api-remotes",
        "@hydra1902/harness-client-connection",
        "@hydra1902/harness-client-runtime",
        "@hydra1902/harness-client-ui-conversation",
        "@hydra1902/harness-client-ui-layout",
        "@hydra1902/harness-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {
    "@hydra1902/harness-fs-review": "workspace:^",
    "@hydra1902/harness-api-remotes": "workspace:^",
    "@hydra1902/harness-client-connection": "workspace:^",
    "@hydra1902/harness-client-runtime": "workspace:^",
    "@hydra1902/harness-client-ui-conversation": "workspace:^",
    "@hydra1902/harness-client-ui-layout": "workspace:^",
    "@hydra1902/harness-client-ui-tool": "workspace:^",
    "@hydra1902/cordis": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^"
  },
  "devDependencies": {
    "@hydra1902/harness-api-remotes": "workspace:^",
    "@hydra1902/harness-client-connection": "workspace:^",
    "@hydra1902/harness-client-runtime": "workspace:^",
    "@hydra1902/harness-client-ui-conversation": "workspace:^",
    "@hydra1902/harness-client-ui-layout": "workspace:^",
    "@hydra1902/harness-client-ui-tool": "workspace:^",
    "@hydra1902/cordis": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-fs-review": "workspace:^",
    "@hydra1902/harness-client-ui-slots": "workspace:^",
    "@hydra1902/harness-client-ui-primitives": "workspace:^",
    "@hydra1902/harness-client-test-runtime": "workspace:^",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
