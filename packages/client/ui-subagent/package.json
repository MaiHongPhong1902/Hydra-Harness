{
  "name": "@hydra/harness-client-ui-subagent",
  "description": "Subagent conversation catalog, continuation routing UI, and '@' reference source",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/client/ui-subagent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "hydra": {
    "plugin": {
      "application": "Navigate delegated conversations, continue child tasks, and reference subagents."
    },
    "client": {
      "inject": [
        "@hydra/harness-client-locale",
        "@hydra/harness-client-runtime",
        "@hydra/harness-client-ui-conversation",
        "@hydra/harness-client-ui-primitives",
        "@hydra/harness-client-ui-input-trigger"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@hydra/harness-client-locale": "workspace:^",
    "@hydra/harness-client-runtime": "workspace:^",
    "@hydra/harness-client-ui-conversation": "workspace:^",
    "@hydra/harness-client-ui-input-trigger": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-subagent": "workspace:^",
    "@hydra/harness-token-meter": "workspace:^",
    "@hydra/cordis": "workspace:^"
  },
  "devDependencies": {
    "@hydra/harness-client-locale": "workspace:^",
    "@hydra/harness-client-runtime": "workspace:^",
    "@hydra/harness-client-test-runtime": "workspace:^",
    "@hydra/harness-client-ui-conversation": "workspace:^",
    "@hydra/harness-client-ui-input-trigger": "workspace:^",
    "@hydra/harness-client-ui-primitives": "workspace:^",
    "@hydra/harness-client-ui-slots": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-subagent": "workspace:^",
    "@hydra/harness-token-meter": "workspace:^",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@hydra/cordis": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
