{
  "name": "@hydra1902/harness-compaction-basic",
  "description": "Token-meter-driven compaction policy and LLM summarization backend for the Hydra harness",
  "hydra": {
    "plugin": {
      "application": "Summarize conversation context when token usage reaches the configured compaction threshold."
    }
  },
  "version": "0.1.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/compaction/compaction-basic"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-compaction": "workspace:^",
    "@hydra1902/harness-commands": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-token-meter": "workspace:^",
    "@hydra1902/harness-compaction-tool-result-pruner": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@hydra1902/harness-compaction-tool-result-pruner": {
      "optional": true
    }
  },
  "dependencies": {
    "@hydra1902/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydra1902/cordis-plugin-include": "workspace:^",
    "@hydra1902/cordis-plugin-loader": "workspace:^",
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-agent-loop": "workspace:^",
    "@hydra1902/harness-agent-loop-testkit": "workspace:^",
    "@hydra1902/harness-compaction": "workspace:^",
    "@hydra1902/harness-commands": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm": "workspace:^",
    "@hydra1902/harness-llm-retry": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-token-meter": "workspace:^",
    "@hydra1902/harness-compaction-tool-result-pruner": "workspace:^",
    "@hydra1902/harness-tools": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  }
}
