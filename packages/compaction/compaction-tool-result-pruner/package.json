{
  "name": "@hydra1902/harness-compaction-tool-result-pruner",
  "description": "Replay-safe model-free head/middle/tail pruning for tool-result surface nodes",
  "hydra": {
    "plugin": {
      "application": "Reduce long tool results in model context while retaining selected beginning, middle, and ending content."
    }
  },
  "version": "0.1.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/compaction/compaction-tool-result-pruner"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra1902/harness-compaction": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-token-meter": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydra1902/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydra1902/cordis-plugin-include": "workspace:^",
    "@hydra1902/cordis-plugin-loader": "workspace:^",
    "@hydra1902/harness-compaction": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-token-meter": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  }
}
