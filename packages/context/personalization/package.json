{
  "name": "@hydra/harness-personalization",
  "description": "Local personality and explicit local memories with durable session provenance",
  "hydra": {
    "plugin": {
      "application": "Apply the user's saved custom instructions, personality, and memory preferences to conversations."
    }
  },
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/context/personalization"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra/harness-agent": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/harness-settings": "workspace:^",
    "@hydra/harness-system-prompt": "workspace:^",
    "@hydra/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydra/harness-atomic-write": "workspace:^",
    "@hydra/harness-commands": "workspace:^",
    "@hydra/harness-home-paths": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydra/harness-agent": "workspace:^",
    "@hydra/harness-agent-loop": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/harness-settings": "workspace:^",
    "@hydra/harness-system-prompt": "workspace:^",
    "@hydra/cordis": "workspace:^",
    "@hydra/cordis-plugin-loader": "workspace:^"
  }
}
