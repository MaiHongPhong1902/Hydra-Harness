{
  "name": "@bosch/bh-agent-loop",
  "description": "The concrete agent loop plugin for the Bosch Harness",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosch/bosch-harness.git",
    "directory": "packages/core/agent-loop"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@bosch/bh-agent": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@bosch/bh-llm": "workspace:^",
    "@bosch/bh-scope": "workspace:^",
    "@bosch/bh-session": "workspace:^",
    "@bosch/bh-session-persistence": "workspace:^",
    "@bosch/bh-system-prompt": "workspace:^",
    "@bosch/bh-tools": "workspace:^",
    "@bosch/cordis": "workspace:^",
    "@bosch/bh-settings": "workspace:^"
  },
  "dependencies": {
    "@bosch/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@bosch/bh-agent": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@bosch/bh-llm": "workspace:^",
    "@bosch/bh-scope": "workspace:^",
    "@bosch/bh-session": "workspace:^",
    "@bosch/bh-session-persistence": "workspace:^",
    "@bosch/bh-session-persistence-jsonl": "workspace:^",
    "@bosch/bh-system-prompt": "workspace:^",
    "@bosch/bh-tools": "workspace:^",
    "@bosch/cordis": "workspace:^",
    "@bosch/bh-settings": "workspace:^"
  }
}
