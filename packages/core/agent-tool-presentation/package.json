{
  "name": "@hydra1902/harness-agent-tool-presentation",
  "description": "Agent-plane presentation selector: composes one agent's tools as Code Mode, native, or both",
  "hydra": {
    "plugin": {
      "application": "Expose a preset's tools as native calls, Code Mode functions, or both."
    }
  },
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/core/agent-tool-presentation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@hydra1902/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-tools": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  },
  "devDependencies": {
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-code-runtime": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-scope": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-system-prompt": "workspace:^",
    "@hydra1902/harness-tools": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  }
}
