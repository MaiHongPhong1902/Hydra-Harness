{
  "name": "@bosch/bh-fs-local",
  "description": "Local-filesystem implementation of the Bosch Harness filesystem seam (ctx.fs)",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosch/bosch-harness.git",
    "directory": "packages/fs/fs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@bosch/bh-fs": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@bosch/cordis": "workspace:^"
  },
  "dependencies": {
    "koffi": "^3.1.0",
    "@bosch/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@bosch/bh-fs": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@bosch/bh-llm": "workspace:^",
    "@bosch/cordis": "workspace:^"
  }
}
