{
  "name": "@hydra1902/harness-tool-str-replace-editor",
  "description": "Model-facing view, create, literal replace, and line insert tool over the Harness filesystem service",
  "hydra": {
    "plugin": {
      "application": "Let the agent view files, create files, replace exact text, or insert lines."
    }
  },
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/fs/tool-str-replace-editor"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra1902/harness-fs": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-sandbox": "workspace:^",
    "@hydra1902/harness-sandbox-policy": "workspace:^",
    "@hydra1902/harness-tools": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydra1902/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-fs": "workspace:^",
    "@hydra1902/harness-fs-local": "workspace:^",
    "@hydra1902/harness-fs-observation-policy": "workspace:^",
    "@hydra1902/harness-fs-sandbox": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm": "workspace:^",
    "@hydra1902/harness-sandbox": "workspace:^",
    "@hydra1902/harness-sandbox-policy": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-system-prompt": "workspace:^",
    "@hydra1902/harness-tools": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  }
}
