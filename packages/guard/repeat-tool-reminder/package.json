{
  "name": "@hydra/harness-repeat-tool-reminder",
  "description": "Repeat-tool-call guard plugin: advisory reminders when an agent loops on identical tool calls",
  "hydra": {
    "plugin": {
      "application": "Remind an agent to change approach when it repeatedly calls the same tool with the same arguments."
    }
  },
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/guard/repeat-tool-reminder"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@hydra/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@hydra/harness-agent": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-tools": "workspace:^",
    "@hydra/cordis": "workspace:^"
  },
  "devDependencies": {
    "@hydra/harness-agent": "workspace:^",
    "@hydra/harness-agent-loop": "workspace:^",
    "@hydra/harness-agent-loop-testkit": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/harness-tools": "workspace:^",
    "@hydra/cordis": "workspace:^"
  }
}
