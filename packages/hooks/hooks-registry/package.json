{
  "name": "@bosch/bh-hooks-registry",
  "description": "Settings-backed hook records that mount and unmount Claude Code and Codex hook bridges",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosch/bosch-harness.git",
    "directory": "packages/hooks/hooks-registry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@bosch/bh-atomic-write": "workspace:^",
    "@bosch/bh-home-paths": "workspace:^",
    "@bosch/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@bosch/bh-hooks-claude-code": "workspace:^",
    "@bosch/bh-hooks-codex": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@bosch/bh-session": "workspace:^",
    "@bosch/bh-settings": "workspace:^",
    "@bosch/cordis": "workspace:^"
  },
  "devDependencies": {
    "@bosch/bh-hooks-claude-code": "workspace:^",
    "@bosch/bh-hooks-codex": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@bosch/bh-session": "workspace:^",
    "@bosch/bh-settings": "workspace:^",
    "@bosch/bh-settings-file": "workspace:^",
    "@bosch/cordis": "workspace:^",
    "@bosch/cordis-plugin-loader": "workspace:^"
  }
}
