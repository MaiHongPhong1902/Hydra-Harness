{
  "name": "@hydra1902/harness-hooks-registry",
  "description": "Settings-backed hook records that mount and unmount Claude Code and Codex hook bridges",
  "hydra": {
    "plugin": {
      "application": "Save hook definitions and enable or disable their execution bridges."
    }
  },
  "version": "0.1.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/hooks/hooks-registry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@hydra1902/harness-atomic-write": "workspace:^",
    "@hydra1902/harness-home-paths": "workspace:^",
    "@hydra1902/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@hydra1902/harness-hooks-claude-code": "workspace:^",
    "@hydra1902/harness-hooks-codex": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-settings": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  },
  "devDependencies": {
    "@hydra1902/harness-hooks-claude-code": "workspace:^",
    "@hydra1902/harness-hooks-codex": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-settings": "workspace:^",
    "@hydra1902/harness-settings-file": "workspace:^",
    "@hydra1902/cordis": "workspace:^",
    "@hydra1902/cordis-plugin-loader": "workspace:^"
  }
}
