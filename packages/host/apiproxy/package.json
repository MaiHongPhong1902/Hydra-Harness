{
  "name": "@bosch/bh-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosch/bosch-harness.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@bosch/bh-attachment": "workspace:^",
    "@bosch/bh-agent": "workspace:^",
    "@bosch/bh-agent-default-model": "workspace:^",
    "@bosch/bh-api-remotes": "workspace:^",
    "@bosch/bh-brand": "workspace:^",
    "@bosch/bh-commands": "workspace:^",
    "@bosch/bh-credentials": "workspace:^",
    "@bosch/bh-goal": "workspace:^",
    "@bosch/bh-host-directory-picker": "workspace:^",
    "@bosch/bh-llm": "workspace:^",
    "@bosch/bh-native-command": "workspace:^",
    "@bosch/bh-session": "workspace:^",
    "@bosch/bh-session-persistence": "workspace:^",
    "@bosch/bh-session-projection": "workspace:^",
    "@bosch/bh-session-projection-cache": "workspace:^",
    "@bosch/bh-session-query": "workspace:^",
    "@bosch/bh-session-title": "workspace:^",
    "@bosch/bh-settings": "workspace:^",
    "@bosch/bh-skill": "workspace:^",
    "@bosch/bh-subagent": "workspace:^",
    "@bosch/bh-jobs": "workspace:^",
    "@bosch/bh-tools": "workspace:^",
    "@bosch/bh-user-approval": "workspace:^",
    "@bosch/bh-user-questions": "workspace:^",
    "@bosch/bh-workspace": "workspace:^",
    "@bosch/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@bosch/cordis": "workspace:^",
    "@bosch/bh-agent-presets": "workspace:^",
    "@bosch/bh-cordis-host-runner": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@bosch/bh-permission-presets": "workspace:^"
  },
  "devDependencies": {
    "@bosch/cordis": "workspace:^",
    "@bosch/bh-agent-presets": "workspace:^",
    "@bosch/bh-cordis-host-runner": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@bosch/bh-permission-presets": "workspace:^",
    "@bosch/bh-storage": "workspace:^",
    "@bosch/bh-storage-domain": "workspace:^",
    "@bosch/bh-typert-protocol": "workspace:^",
    "@bosch/bh-typert-registry": "workspace:^",
    "@bosch/cordis": "workspace:^"
  }
}
