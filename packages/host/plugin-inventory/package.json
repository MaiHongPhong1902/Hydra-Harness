{
  "name": "@bosch/bh-host-plugin-inventory",
  "description": "Remote projection and shared-settings controls for current Cordis Loader plugin state",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosch/bosch-harness.git",
    "directory": "packages/host/plugin-inventory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@bosch/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@bosch/bh-app-boot": "workspace:^",
    "@bosch/bh-atomic-write": "workspace:^",
    "@bosch/bh-brand": "workspace:^",
    "@bosch/bh-hooks-registry": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@bosch/bh-mcp-registry": "workspace:^",
    "@bosch/bh-plugin-runtime": "workspace:^",
    "@bosch/bh-settings": "workspace:^",
    "@bosch/bh-typert-protocol": "workspace:^",
    "@bosch/cordis": "workspace:^",
    "@bosch/cordis-plugin-include": "workspace:^",
    "@bosch/cordis-plugin-loader": "workspace:^"
  },
  "devDependencies": {
    "@bosch/bh-app-boot": "workspace:^",
    "@bosch/bh-atomic-write": "workspace:^",
    "@bosch/bh-brand": "workspace:^",
    "@bosch/bh-hooks-registry": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@bosch/bh-mcp-registry": "workspace:^",
    "@bosch/bh-plugin-runtime": "workspace:^",
    "@bosch/bh-settings": "workspace:^",
    "@bosch/bh-settings-file": "workspace:^",
    "@bosch/bh-typert-protocol": "workspace:^",
    "@bosch/cordis": "workspace:^",
    "@bosch/cordis-plugin-include": "workspace:^",
    "@bosch/cordis-plugin-loader": "workspace:^"
  }
}
