{
  "name": "@hydra1902/harness-commands",
  "description": "Plugin-owned human command registry for Hydra harness UIs",
  "hydra": {
    "plugin": {
      "application": "Make plugin-provided slash commands available to the user."
    }
  },
  "version": "0.1.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/interaction/commands"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./brand": {
      "types": "./lib/types/brand.d.ts",
      "default": "./lib/types/brand.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-attachment": "workspace:^",
    "@hydra1902/harness-brand": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm": "workspace:^",
    "@hydra1902/harness-scope": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-typert-protocol": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-attachment": "workspace:^",
    "@hydra1902/harness-brand": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm": "workspace:^",
    "@hydra1902/harness-scope": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-typert-protocol": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  }
}
