{
  "name": "@hydra1902/harness-jobs-local",
  "description": "Process-local implementation of the Hydra harness background job registry seam",
  "hydra": {
    "plugin": {
      "application": "Track long-running local jobs so their output can be read and the jobs can be stopped later."
    }
  },
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/jobs/jobs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-scope": "workspace:^",
    "@hydra1902/harness-jobs": "workspace:^",
    "@hydra1902/harness-timeout": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydra1902/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydra1902/cordis-plugin-include": "workspace:^",
    "@hydra1902/cordis-plugin-loader": "workspace:^",
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-brand": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-scope": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-jobs": "workspace:^",
    "@hydra1902/harness-timeout": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  }
}
