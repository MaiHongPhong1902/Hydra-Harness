{
  "name": "@hydra/harness-tool-jobs",
  "description": "Model-facing background job control tools (job_output, job_list, job_kill) over the ctx.jobs registry",
  "hydra": {
    "plugin": {
      "application": "Let the agent list background jobs, retrieve their output, or stop them."
    }
  },
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/jobs/tool-jobs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@hydra/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@hydra/harness-agent": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-output-retention": "workspace:^",
    "@hydra/harness-system-prompt": "workspace:^",
    "@hydra/harness-jobs": "workspace:^",
    "@hydra/harness-tools": "workspace:^",
    "@hydra/cordis": "workspace:^"
  },
  "devDependencies": {
    "@hydra/harness-agent": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-output-retention": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/harness-system-prompt": "workspace:^",
    "@hydra/harness-jobs": "workspace:^",
    "@hydra/harness-jobs-local": "workspace:^",
    "@hydra/harness-tools": "workspace:^",
    "@hydra/cordis": "workspace:^"
  }
}
