{
  "name": "@hydraharness/harness-llm-account-auth",
  "description": "Native multi-account OAuth adapters for ChatGPT and Google Antigravity",
  "hydra": {
    "plugin": {
      "application": "Sign in to supported ChatGPT or Google Antigravity accounts and manage their model access."
    }
  },
  "version": "0.1.1-rc.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/llm/llm-account-auth"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/*-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydraharness/harness-attachment": "workspace:^",
    "@hydraharness/harness-authorization": "workspace:^",
    "@hydraharness/harness-credentials": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-llm-pi-ai": "workspace:^",
    "@hydraharness/harness-settings": "workspace:^",
    "@hydraharness/harness-timeout": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@hydraharness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydraharness/harness-attachment": "workspace:^",
    "@hydraharness/harness-authorization": "workspace:^",
    "@hydraharness/harness-credentials": "workspace:^",
    "@hydraharness/harness-invariants": "workspace:^",
    "@hydraharness/harness-llm": "workspace:^",
    "@hydraharness/harness-llm-pi-ai": "workspace:^",
    "@hydraharness/harness-session": "workspace:^",
    "@hydraharness/harness-settings": "workspace:^",
    "@hydraharness/harness-timeout": "workspace:^",
    "@hydraharness/cordis": "workspace:^"
  }
}
