{
  "name": "@hydra/harness-llm-deepseek",
  "description": "DeepSeek chat-completions adapter for the Hydra harness LLM seam",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosch/bosch-harness.git",
    "directory": "packages/llm/llm-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra/harness-attachment": "workspace:^",
    "@hydra/harness-credentials": "workspace:^",
    "@hydra/harness-launch-environment": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-settings": "workspace:^",
    "@hydra/harness-timeout": "workspace:^",
    "@hydra/harness-anonymous-user-id": "workspace:^",
    "@hydra/cordis": "workspace:^"
  },
  "dependencies": {
    "eventsource-parser": "^3.1.0",
    "@hydra/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydra/harness-attachment": "workspace:^",
    "@hydra/harness-credentials": "workspace:^",
    "@hydra/harness-launch-environment": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-settings": "workspace:^",
    "@hydra/harness-timeout": "workspace:^",
    "@hydra/harness-anonymous-user-id": "workspace:^",
    "@hydra/cordis": "workspace:^"
  }
}
