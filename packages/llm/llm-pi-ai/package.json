{
  "name": "@bosch/bh-llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the Bosch Harness LLM seam (design-verification twin of bh-llm-deepseek)",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosch/bosch-harness.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@bosch/bh-attachment": "workspace:^",
    "@bosch/bh-authorization": "workspace:^",
    "@bosch/bh-credentials": "workspace:^",
    "@bosch/bh-launch-environment": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@bosch/bh-llm": "workspace:^",
    "@bosch/bh-settings": "workspace:^",
    "@bosch/bh-timeout": "workspace:^",
    "@bosch/cordis": "workspace:^"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@bosch/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@bosch/bh-attachment": "workspace:^",
    "@bosch/bh-authorization": "workspace:^",
    "@bosch/bh-credentials": "workspace:^",
    "@bosch/bh-launch-environment": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@bosch/bh-llm": "workspace:^",
    "@bosch/bh-llm-deepseek": "workspace:^",
    "@bosch/bh-settings": "workspace:^",
    "@bosch/bh-timeout": "workspace:^",
    "@bosch/cordis": "workspace:^"
  }
}
