{
  "name": "@hydra1902/harness-llm-retry",
  "description": "Provider-routed LLM request retry policy for the Hydra harness",
  "hydra": {
    "plugin": {
      "application": "Retry eligible model request failures according to the selected provider's retry policy."
    }
  },
  "version": "0.1.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/llm/llm-retry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra1902/harness-brand": "workspace:^",
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-timeout": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydra1902/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydra1902/harness-brand": "workspace:^",
    "@hydra1902/cordis-plugin-include": "workspace:^",
    "@hydra1902/cordis-plugin-loader": "workspace:^",
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-agent-loop": "workspace:^",
    "@hydra1902/harness-agent-loop-testkit": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm": "workspace:^",
    "@hydra1902/harness-llm-deepseek": "workspace:^",
    "@hydra1902/harness-llm-mock-server": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-session-persistence-jsonl": "workspace:^",
    "@hydra1902/harness-session-persistence-sqlite": "workspace:^",
    "@hydra1902/harness-system-prompt": "workspace:^",
    "@hydra1902/harness-timeout": "workspace:^",
    "@hydra1902/harness-tools": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  }
}
