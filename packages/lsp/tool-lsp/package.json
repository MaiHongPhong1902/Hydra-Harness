{
  "name": "@hydra1902/harness-tool-lsp",
  "description": "Model-facing lsp tool over the Hydra harness LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm": "workspace:^",
    "@hydra1902/harness-lsp": "workspace:^",
    "@hydra1902/harness-system-prompt": "workspace:^",
    "@hydra1902/harness-timeout": "workspace:^",
    "@hydra1902/harness-tools": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydra1902/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-fs-local": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm": "workspace:^",
    "@hydra1902/harness-lsp": "workspace:^",
    "@hydra1902/harness-lsp-stdio": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-subprocess-local": "workspace:^",
    "@hydra1902/harness-system-prompt": "workspace:^",
    "@hydra1902/harness-timeout": "workspace:^",
    "@hydra1902/harness-tool-call-timeout-policy": "workspace:^",
    "@hydra1902/harness-tools": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  }
}
