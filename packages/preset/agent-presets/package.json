{
  "name": "@bosch/bh-agent-presets",
  "description": "Per-session agent composition from preset cordis.yml files for the Bosch Harness",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosch/bosch-harness.git",
    "directory": "packages/preset/agent-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@bosch/cordis-plugin-include": "workspace:^",
    "@bosch/cordis-plugin-loader": "workspace:^",
    "@bosch/bh-agent": "workspace:^",
    "@bosch/bh-atomic-write": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@bosch/bh-home-paths": "workspace:^",
    "@bosch/bh-scope": "workspace:^",
    "@bosch/bh-session": "workspace:^",
    "@bosch/bh-settings": "workspace:^",
    "@bosch/bh-system-prompt": "workspace:^",
    "@bosch/cordis": "workspace:^"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "@bosch/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@bosch/cordis-plugin-include": "workspace:^",
    "@bosch/cordis-plugin-loader": "workspace:^",
    "@bosch/bh-agent": "workspace:^",
    "@bosch/bh-agent-loop": "workspace:^",
    "@bosch/bh-atomic-write": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@bosch/bh-llm": "workspace:^",
    "@bosch/bh-home-paths": "workspace:^",
    "@bosch/bh-scope": "workspace:^",
    "@bosch/bh-session": "workspace:^",
    "@bosch/bh-settings": "workspace:^",
    "@bosch/bh-settings-file": "workspace:^",
    "@bosch/bh-system-prompt": "workspace:^",
    "@bosch/bh-tools": "workspace:^",
    "@bosch/cordis": "workspace:^"
  }
}
