{
  "name": "@hydra/harness-agent-presets",
  "description": "Per-session agent composition from preset cordis.yml files for the Hydra harness",
  "hydra": {
    "plugin": {
      "application": "Choose a preset to control which tools, providers, and instructions new sessions receive."
    }
  },
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/preset/agent-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra/cordis-plugin-include": "workspace:^",
    "@hydra/cordis-plugin-loader": "workspace:^",
    "@hydra/harness-agent": "workspace:^",
    "@hydra/harness-atomic-write": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-home-paths": "workspace:^",
    "@hydra/harness-scope": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/harness-settings": "workspace:^",
    "@hydra/harness-system-prompt": "workspace:^",
    "@hydra/cordis": "workspace:^"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "@hydra/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydra/cordis-plugin-include": "workspace:^",
    "@hydra/cordis-plugin-loader": "workspace:^",
    "@hydra/harness-agent": "workspace:^",
    "@hydra/harness-agent-loop": "workspace:^",
    "@hydra/harness-atomic-write": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-home-paths": "workspace:^",
    "@hydra/harness-scope": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/harness-settings": "workspace:^",
    "@hydra/harness-settings-file": "workspace:^",
    "@hydra/harness-system-prompt": "workspace:^",
    "@hydra/harness-tools": "workspace:^",
    "@hydra/cordis": "workspace:^"
  }
}
