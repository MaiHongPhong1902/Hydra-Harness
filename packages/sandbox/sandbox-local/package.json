{
  "name": "@hydra1902/harness-sandbox-local",
  "description": "Local process-sandbox backends for the Hydra harness sandbox seam: bwrap, the npm-distributed landlock-run launcher, macOS Seatbelt, or the Windows ACL restricted-token runner — functionally probed, fail-closed",
  "hydra": {
    "plugin": {
      "application": "Enforce process restrictions through the sandbox backend available on the current operating system."
    }
  },
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/sandbox/sandbox-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm": "workspace:^",
    "@hydra1902/harness-sandbox": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydra1902/harness-sandbox-windows-acl": "workspace:^",
    "@hydra1902/node-addon-landlock-run": "workspace:^",
    "@hydra1902/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm": "workspace:^",
    "@hydra1902/harness-sandbox": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  }
}
