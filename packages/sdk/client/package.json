{
  "name": "@hydra/harness-sdk-client",
  "description": "TypeScript client SDK for driving a Hydra harness runtime subprocess over stdio JSON-RPC: the HydraHarness high-level turns API and the lower-level HarnessClient",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/sdk/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-sdk-protocol": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/cordis": "workspace:^"
  },
  "devDependencies": {
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-sdk-protocol": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/cordis": "workspace:^"
  }
}
