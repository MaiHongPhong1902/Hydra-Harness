{
  "name": "@hydra1902/harness-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Hydra harness SDK clients",
  "version": "0.1.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@hydra1902/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm": "workspace:^",
    "@hydra1902/harness-llm-deepseek": "workspace:^",
    "@hydra1902/harness-scope": "workspace:^",
    "@hydra1902/harness-sdk-protocol": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-subagent": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  },
  "devDependencies": {
    "@hydra1902/cordis-plugin-loader": "workspace:^",
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-agent-spine-demo": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm": "workspace:^",
    "@hydra1902/harness-llm-deepseek": "workspace:^",
    "@hydra1902/harness-scope": "workspace:^",
    "@hydra1902/harness-sdk-protocol": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-session-persistence-jsonl": "workspace:^",
    "@hydra1902/harness-subagent": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  }
}
