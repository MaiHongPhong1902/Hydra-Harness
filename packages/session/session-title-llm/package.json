{
  "name": "@hydra/harness-session-title-llm",
  "description": "Shared LLM generation policy for Hydra harness session-title providers",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosch/bosch-harness.git",
    "directory": "packages/session/session-title-llm"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/harness-session-title": "workspace:^",
    "@hydra/harness-timeout": "workspace:^",
    "@hydra/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydra/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/harness-session-title": "workspace:^",
    "@hydra/harness-timeout": "workspace:^",
    "@hydra/cordis": "workspace:^"
  }
}
