{
  "name": "@hydra/harness-bash-local",
  "description": "Local-subprocess implementation of the Hydra harness bash executor seam",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosch/bosch-harness.git",
    "directory": "packages/shell/bash-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra/harness-shell": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-subprocess": "workspace:^",
    "@hydra/harness-timeout": "workspace:^",
    "@hydra/cordis": "workspace:^",
    "@hydra/harness-settings": "workspace:^"
  },
  "dependencies": {
    "@hydra/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydra/harness-shell": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-subprocess": "workspace:^",
    "@hydra/harness-subprocess-local": "workspace:^",
    "@hydra/harness-timeout": "workspace:^",
    "@hydra/cordis": "workspace:^",
    "@hydra/harness-settings": "workspace:^"
  }
}
