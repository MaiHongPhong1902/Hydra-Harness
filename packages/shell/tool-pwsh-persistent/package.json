{
  "name": "@hydra1902/harness-tool-pwsh-persistent",
  "description": "Model-facing owner-scoped persistent PowerShell tool backed by the Harness PTY service",
  "hydra": {
    "plugin": {
      "application": "Let the agent reuse a persistent PowerShell terminal across commands."
    }
  },
  "version": "0.1.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/shell/tool-pwsh-persistent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-terminal": "workspace:^",
    "@hydra1902/harness-timeout": "workspace:^",
    "@hydra1902/harness-tools": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydra1902/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydra1902/cordis-plugin-include": "workspace:^",
    "@hydra1902/cordis-plugin-loader": "workspace:^",
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm": "workspace:^",
    "@hydra1902/harness-terminal": "workspace:^",
    "@hydra1902/harness-terminal-bash": "workspace:^",
    "@hydra1902/harness-pwsh-local": "workspace:^",
    "@hydra1902/harness-sandbox": "workspace:^",
    "@hydra1902/harness-sandbox-policy": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-subprocess-local": "workspace:^",
    "@hydra1902/harness-system-prompt": "workspace:^",
    "@hydra1902/harness-timeout": "workspace:^",
    "@hydra1902/harness-tools": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  }
}
