{
  "name": "@hydra/harness-spill-local",
  "description": "Local-filesystem implementation of the Hydra harness spill storage seam (private session-scoped files)",
  "hydra": {
    "plugin": {
      "application": "Store large tool output privately on disk for later retrieval within the session."
    }
  },
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/spill/spill-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-spill": "workspace:^",
    "@hydra/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydra/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydra/harness-brand": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/harness-spill": "workspace:^",
    "@hydra/cordis": "workspace:^"
  }
}
