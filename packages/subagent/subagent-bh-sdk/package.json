{
  "name": "@hydra/harness-subagent-bh-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child Hydra harness runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosch/bosch-harness.git",
    "directory": "packages/subagent/subagent-bh-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra/harness-agent": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-sdk-client": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/harness-subagent": "workspace:^",
    "@hydra/harness-subprocess": "workspace:^",
    "@hydra/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydra/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydra/cordis-plugin-loader": "workspace:^",
    "@hydra/harness-agent": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-loader-smoke": "workspace:^",
    "@hydra/harness-sdk-client": "workspace:^",
    "@hydra/harness-sdk-protocol": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/harness-subagent": "workspace:^",
    "@hydra/harness-subprocess": "workspace:^",
    "@hydra/cordis": "workspace:^"
  }
}
