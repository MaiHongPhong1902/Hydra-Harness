{
  "name": "@hydra/harness-subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "hydra": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/harness-subagent": "workspace:^",
    "@hydra/harness-subprocess": "workspace:^",
    "@hydra/harness-timeout": "workspace:^",
    "@hydra/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydra/harness-sdk-protocol": "workspace:^",
    "@hydra/schemastery": "workspace:^",
    "@openai/codex": "0.147.0"
  },
  "devDependencies": {
    "@hydra/cordis-plugin-loader": "workspace:^",
    "@hydra/harness-agent": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-loader-smoke": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/harness-subagent": "workspace:^",
    "@hydra/harness-subprocess": "workspace:^",
    "@hydra/harness-subprocess-local": "workspace:^",
    "@hydra/harness-timeout": "workspace:^",
    "@hydra/cordis": "workspace:^"
  }
}
