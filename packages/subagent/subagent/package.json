{
  "name": "@hydra1902/harness-subagent",
  "description": "Abstract subagent seam (ctx.subagents): named-provider registry for delegating to child agents",
  "hydra": {
    "plugin": {
      "application": "Delegate work to registered child-agent providers and track their continuations."
    }
  },
  "version": "0.1.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/subagent/subagent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "^4.4.3",
    "@hydra1902/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-agent-presets": "workspace:^",
    "@hydra1902/harness-brand": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm": "workspace:^",
    "@hydra1902/harness-sandbox": "workspace:^",
    "@hydra1902/harness-sandbox-policy": "workspace:^",
    "@hydra1902/harness-scope": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-session-persistence": "workspace:^",
    "@hydra1902/harness-session-projection": "workspace:^",
    "@hydra1902/harness-session-projection-cache": "workspace:^",
    "@hydra1902/harness-jobs": "workspace:^",
    "@hydra1902/harness-tools": "workspace:^",
    "@hydra1902/harness-user-approval": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@hydra1902/harness-agent-presets": {
      "optional": true
    },
    "@hydra1902/harness-sandbox": {
      "optional": true
    },
    "@hydra1902/harness-sandbox-policy": {
      "optional": true
    },
    "@hydra1902/harness-session-persistence": {
      "optional": true
    },
    "@hydra1902/harness-session-projection": {
      "optional": true
    },
    "@hydra1902/harness-session-projection-cache": {
      "optional": true
    },
    "@hydra1902/harness-jobs": {
      "optional": true
    },
    "@hydra1902/harness-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-agent-presets": "workspace:^",
    "@hydra1902/harness-brand": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-llm": "workspace:^",
    "@hydra1902/harness-sandbox": "workspace:^",
    "@hydra1902/harness-sandbox-policy": "workspace:^",
    "@hydra1902/harness-scope": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-session-persistence": "workspace:^",
    "@hydra1902/harness-session-projection": "workspace:^",
    "@hydra1902/harness-session-projection-cache": "workspace:^",
    "@hydra1902/harness-storage": "workspace:^",
    "@hydra1902/harness-storage-domain": "workspace:^",
    "@hydra1902/harness-jobs": "workspace:^",
    "@hydra1902/harness-tools": "workspace:^",
    "@hydra1902/harness-user-approval": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  }
}
