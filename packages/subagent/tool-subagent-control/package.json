{
  "name": "@hydra/harness-tool-subagent-control",
  "description": "Globally named send_message, interrupt_agent, and list_agents tools over ctx.subagents continuations",
  "hydra": {
    "plugin": {
      "application": "Let the agent list child agents, send follow-up messages, or interrupt their work."
    }
  },
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/subagent/tool-subagent-control"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./list-agents": {
      "types": "./lib/types/list-agents.d.ts",
      "default": "./lib/types/list-agents.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/harness-subagent": "workspace:^",
    "@hydra/harness-tools": "workspace:^",
    "@hydra/cordis": "workspace:^"
  },
  "devDependencies": {
    "@hydra/harness-agent": "workspace:^",
    "@hydra/harness-agent-loop": "workspace:^",
    "@hydra/harness-agent-loop-testkit": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-llm": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/harness-session-persistence": "workspace:^",
    "@hydra/harness-session-persistence-jsonl": "workspace:^",
    "@hydra/harness-session-projection": "workspace:^",
    "@hydra/harness-subagent": "workspace:^",
    "@hydra/harness-subagent-spawn-in-process": "workspace:^",
    "@hydra/harness-tools": "workspace:^",
    "@hydra/cordis": "workspace:^"
  }
}
