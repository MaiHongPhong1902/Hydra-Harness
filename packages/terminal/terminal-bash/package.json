{
  "name": "@hydra1902/harness-terminal-bash",
  "description": "Persistent shell PTY backend over the Hydra harness subprocess terminal primitive",
  "hydra": {
    "plugin": {
      "application": "Provide a persistent shell terminal for commands that need an interactive process."
    }
  },
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-terminal": "workspace:^",
    "@hydra1902/harness-sandbox": "workspace:^",
    "@hydra1902/harness-sandbox-policy": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-subprocess": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  },
  "dependencies": {
    "@hydra1902/harness-pwsh-local": "workspace:^",
    "@hydra1902/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydra1902/harness-agent": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-terminal": "workspace:^",
    "@hydra1902/harness-sandbox": "workspace:^",
    "@hydra1902/harness-sandbox-policy": "workspace:^",
    "@hydra1902/harness-session": "workspace:^",
    "@hydra1902/harness-subprocess": "workspace:^",
    "@hydra1902/harness-subprocess-local": "workspace:^",
    "@hydra1902/cordis": "workspace:^"
  }
}
