{
  "name": "@hydra/harness-terminal",
  "description": "Persistent PTY session seam for the Hydra harness — owner-scoped ids, backend registry, interactive sends, reads, signals, and awaited cleanup",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosch/bosch-harness.git",
    "directory": "packages/terminal/terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra/harness-agent": "workspace:^",
    "@hydra/harness-brand": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/cordis": "workspace:^"
  },
  "devDependencies": {
    "@hydra/harness-agent": "workspace:^",
    "@hydra/harness-brand": "workspace:^",
    "@hydra/harness-invariants": "workspace:^",
    "@hydra/harness-session": "workspace:^",
    "@hydra/cordis": "workspace:^"
  }
}
