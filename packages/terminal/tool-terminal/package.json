{
  "name": "@bosch/bh-tool-terminal",
  "description": "Six model-facing persistent PTY tools with owner isolation and generic background-job integration",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosch/bosch-harness.git",
    "directory": "packages/terminal/tool-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@bosch/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@bosch/bh-agent": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@bosch/bh-llm": "workspace:^",
    "@bosch/bh-terminal": "workspace:^",
    "@bosch/bh-output-retention": "workspace:^",
    "@bosch/bh-system-prompt": "workspace:^",
    "@bosch/bh-jobs": "workspace:^",
    "@bosch/bh-tools": "workspace:^",
    "@bosch/cordis": "workspace:^"
  },
  "devDependencies": {
    "@bosch/cordis-plugin-include": "workspace:^",
    "@bosch/cordis-plugin-loader": "workspace:^",
    "@bosch/bh-agent": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@bosch/bh-llm": "workspace:^",
    "@bosch/bh-terminal": "workspace:^",
    "@bosch/bh-terminal-bash": "workspace:^",
    "@bosch/bh-output-retention": "workspace:^",
    "@bosch/bh-sandbox": "workspace:^",
    "@bosch/bh-sandbox-policy": "workspace:^",
    "@bosch/bh-session": "workspace:^",
    "@bosch/bh-subprocess-local": "workspace:^",
    "@bosch/bh-system-prompt": "workspace:^",
    "@bosch/bh-jobs": "workspace:^",
    "@bosch/bh-jobs-local": "workspace:^",
    "@bosch/bh-tool-jobs": "workspace:^",
    "@bosch/bh-tools": "workspace:^",
    "@bosch/cordis": "workspace:^"
  }
}
