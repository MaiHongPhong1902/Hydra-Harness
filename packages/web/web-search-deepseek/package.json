{
  "name": "@bosch/bh-web-search-deepseek",
  "description": "DeepSeek-backed search provider (native web_search via the Anthropic-compatible API) for the Bosch Harness web capability seam (ctx.web)",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosch/bosch-harness.git",
    "directory": "packages/web/web-search-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@bosch/bh-agent": "workspace:^",
    "@bosch/bh-credentials": "workspace:^",
    "@bosch/bh-launch-environment": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@bosch/bh-session": "workspace:^",
    "@bosch/bh-web": "workspace:^",
    "@bosch/cordis": "workspace:^",
    "@bosch/bh-settings": "workspace:^"
  },
  "dependencies": {
    "@bosch/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@bosch/bh-agent": "workspace:^",
    "@bosch/bh-credentials": "workspace:^",
    "@bosch/bh-credentials-local": "workspace:^",
    "@bosch/bh-launch-environment": "workspace:^",
    "@bosch/bh-invariants": "workspace:^",
    "@bosch/bh-session": "workspace:^",
    "@bosch/bh-web": "workspace:^",
    "@bosch/cordis": "workspace:^",
    "@bosch/bh-settings": "workspace:^"
  }
}
