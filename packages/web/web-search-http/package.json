{
  "name": "@hydra1902/harness-web-search-http",
  "description": "Serper and configurable JSON HTTP search providers",
  "hydra": {
    "plugin": {
      "application": "Search through Serper or a configured JSON HTTP search endpoint."
    }
  },
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaiHongPhong1902/Hydra-Harness.git",
    "directory": "packages/web/web-search-http"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hydra1902/harness-credentials": "workspace:^",
    "@hydra1902/harness-launch-environment": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-web": "workspace:^",
    "@hydra1902/cordis": "workspace:^",
    "@hydra1902/harness-settings": "workspace:^"
  },
  "dependencies": {
    "@hydra1902/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hydra1902/harness-credentials": "workspace:^",
    "@hydra1902/harness-launch-environment": "workspace:^",
    "@hydra1902/harness-invariants": "workspace:^",
    "@hydra1902/harness-web": "workspace:^",
    "@hydra1902/cordis": "workspace:^",
    "@hydra1902/harness-settings": "workspace:^",
    "@hydra1902/harness-web-search-deepseek": "workspace:^"
  }
}
